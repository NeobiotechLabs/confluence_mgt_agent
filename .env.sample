# .env.sample
# 이 파일을 복사해서 .env 로 저장한 뒤, 실제 값으로 채워 주세요.
#   cp .env.sample .env     (macOS / Linux / Git Bash)
#   copy .env.sample .env   (Windows PowerShell / cmd)
#
# ⚠️  .env 는 절대 커밋하지 마세요 (.gitignore 에 이미 포함됨).

# ─────────────────────────────────────────────────────────────────────────────
# 1) Confluence Cloud 인증 (필수 — 모든 마이그레이션/감사 스크립트가 사용)
# ─────────────────────────────────────────────────────────────────────────────
# Atlassian 계정 이메일 (예: hong.gildong@neobiotech.com)
CONFLUENCE_EMAIL=

# Atlassian API 토큰
# 발급: https://id.atlassian.com/manage-profile/security/api-tokens
# Basic Auth 의 password 자리에 사용됨. 비밀번호 자체는 불필요.
CONFLUENCE_TOKEN=


# ─────────────────────────────────────────────────────────────────────────────
# 2) Anthropic Claude API (선택 — ClaudeClassifier 폴백용)
# ─────────────────────────────────────────────────────────────────────────────
# Anthropic API 키. 미설정 시 RuleClassifier + 휴먼 정책만으로 동작합니다.
ANTHROPIC_API_KEY=