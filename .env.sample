# .env.sample
# 이 파일을 복사해서 .env 로 저장한 뒤, 실제 값으로 채워 주세요.
#   cp .env.sample .env     (macOS / Linux / Git Bash)
#   copy .env.sample .env   (Windows PowerShell / cmd)
#
# ⚠️  .env 는 절대 커밋하지 마세요 (.gitignore 에 이미 포함됨).

# ─────────────────────────────────────────────────────────────────────────────
# 1) Confluence Cloud 인증 (필수 — 모든 마이그레이션/감사 스크립트가 사용)
# ─────────────────────────────────────────────────────────────────────────────
# Atlassian 계정 이메일 (예: hong.gildong@neobiotech.com)
CONFLUENCE_EMAIL=

# Atlassian API 토큰
# 발급: https://id.atlassian.com/manage-profile/security/api-tokens
# Basic Auth 의 password 자리에 사용됨. 비밀번호 자체는 불필요.
CONFLUENCE_TOKEN=


# ─────────────────────────────────────────────────────────────────────────────
# 2) Anthropic Claude API (선택 — ClaudeClassifier 폴백용)
# ─────────────────────────────────────────────────────────────────────────────
# Anthropic API 키. 미설정 시 RuleClassifier + 휴먼 정책만으로 동작합니다.
ANTHROPIC_API_KEY=

# 선택: LLM 게이트웨이 URL (사내 프록시 등). 미설정 시 공식 api.anthropic.com 사용.
# SDK가 이 환경변수를 자동 판독합니다 (코드에서 별도 참조하지 않음).
ANTHROPIC_BASE_URL=

# 선택: 분류기가 호출하는 모델 오버라이드 (scripts/classifiers/claude.js).
# 미설정 시 claude-haiku-4-5-20251001 기본값. 사내 LLM 게이트웨이 사용 시
# 게이트웨이가 제공하는 모델명(예: qwen3.8-max-preview)을 지정하세요.
# 일일 리포트 §6 모델 표기에도 쓰입니다.
ANTHROPIC_MODEL=


# ─────────────────────────────────────────────────────────────────────────────
# 3) GitHub Actions 전용 변수 — ⛔ 로컬 .env 에 설정하지 마세요
# ─────────────────────────────────────────────────────────────────────────────
# CI, GITHUB_RUN_ID, GITHUB_RUN_ATTEMPT, GITHUB_SHA 는 Actions 실행 시 자동 주입됩니다.
# 특히 CI=true 면 로컬 결정 로그(config/classification_decisions.json) 기록이 스킵됩니다.